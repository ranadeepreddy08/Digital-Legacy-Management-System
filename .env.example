# Neo4j Graph Database Configuration
# For local Neo4j Desktop or Docker:
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j

# For Neo4j AuraDB (Cloud Free Tier):
# NEO4J_URI=neo4j+s://<dbid>.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=<your_aura_password>

# Application Server Settings
APP_HOST=127.0.0.1
APP_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Oracle Relational Database Configuration (Dual-Database Integration)
ORACLE_USER=LEGACY_USER
ORACLE_PASSWORD=your_oracle_password_here
ORACLE_DSN=localhost:1521/XE
# Path to 64-bit Oracle Client / Instant Client directory (required for Thick mode)
ORACLE_CLIENT_LIB_DIR=C:\oraclexe\app\oracle\product\11.2.0\server\bin
